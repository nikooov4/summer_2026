@page "/hierarchy2"
@using Blazor.Diagrams
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Components
@inject HttpClient Http
@inject NavigationManager NavManager
@using Blazor.Diagrams.Core.PathGenerators;
@using Blazor.Diagrams.Core.Routers;
@using Blazor.Diagrams.Options;
@using Mephi.Cyber.AuthService.Core.Models
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Geometry


<div style="width: 100%; height: 400px; border: 1px solid black" >
    <CascadingValue Value="Diagram" IsFixed="true">
        <DiagramCanvas></DiagramCanvas>
    </CascadingValue>
</div>

@code {

    private BlazorDiagram Diagram { get; set; } = null!;
    private Entity[]? entities;
    protected override async Task OnInitializedAsync()
    {
        
        Console.WriteLine("lala");
        
       
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            Zoom =
            {
                Enabled = false,
            },
            Links =
            {
                DefaultRouter = new NormalRouter(),
                DefaultPathGenerator = new SmoothPathGenerator()
            },
        };

        Diagram = new BlazorDiagram(options);
        entities = await Http.GetFromJsonAsync<Entity[]>($"admin/object/list?projectName=test");
        var entityNodes = new Dictionary<int, NodeModel>();
        Console.WriteLine("lala");
        
        foreach (var entity in entities)
        {
          
            var node = new NodeModel(new Point(100, 50 * entity.Id))
            {
                Title = entity.Name
            };
            Diagram.Nodes.Add(node);
            entityNodes[entity.Id] = node;
        
            if (entity.ParentId.HasValue && entityNodes.ContainsKey(entity.ParentId.Value))
            {
                var parentNode = entityNodes[entity.ParentId.Value];
                var leftPort = node.AddPort(PortAlignment.Top);
                
                var sourceAnchor = new ShapeIntersectionAnchor(parentNode);

                var targetAnchor = new SinglePortAnchor(leftPort);
                var link = new LinkModel(sourceAnchor, targetAnchor);
                Diagram.Links.Add(link);
            }
        }

    }
}




