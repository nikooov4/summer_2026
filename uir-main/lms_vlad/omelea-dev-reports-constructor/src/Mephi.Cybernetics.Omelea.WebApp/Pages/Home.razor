@page "/"

<section class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Добро пожаловать в систему ведомостей</h1>
        <p class="lead text-muted">
            Этот сервис поможет быстро и удобно формировать, заполнять и просматривать академические ведомости.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <a href="/constructor" class="btn btn-primary">📋 Создать ведомость</a>
                    <p class="card-text">Добавьте студентов и предметы, начните работу с оценками.</p>
                    <a href="/statement" class="btn btn-primary">Перейти к списку доступных ведомостей</a>
                </div>
            </div>
        </div>

        <div class="col-md-5 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">📊 Анализ и экспорт</h5>
                    <p class="card-text">Скоро: выгрузка в PDF/Excel, анализ успеваемости.</p>
                    <button class="btn btn-outline-secondary" disabled>В разработке</button>
                </div>
            </div>
        </div>
    </div>
</section>
