@HostAddress = http://localhost:5000

GET {{HostAddress}}/api/ApprList/definitions
Accept: application/json

###

GET {{HostAddress}}/api/ApprList/marks/Lab1
Accept: application/json

###
GET {{HostAddress}}/api/ApprList/students
Accept: application/json

###

PUT {{HostAddress}}/api/ApprList/definitions
Content-Type: application/json

{
  "concepts": [
    {
      "name": "Lab1",
      "attributes": [
        {
          "name": "testsScore",
          "type": "Int",
          "isComputable": false,
          "expression": null
        },
        {
          "name": "theoryScore",
          "type": "Int",
          "isComputable": false,
          "expression": null
        },
        {
          "name": "maxScore",
          "type": "Int",
          "isComputable": true,
          "expression": "30"
        },
        {
          "name": "score",
          "type": "Int",
          "isComputable": true,
          "expression": "testsScore + theoryScore"
        }
      ]
    }
  ]
}

