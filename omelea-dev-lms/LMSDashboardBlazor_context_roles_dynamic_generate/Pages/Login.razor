@page "/login"
@layout LoginLayout
@inject NavigationManager Navigation
@inject AuthSessionService Auth

<PageTitle>Вход в LMS</PageTitle>
<section class="auth-shell">
    <div class="auth-window">
        <div class="auth-logo"><i class="fas fa-graduation-cap" aria-hidden="true"></i></div>
        <h1>Вход в LMS</h1>
        <form @onsubmit="SubmitLogin" @onsubmit:preventDefault="true" class="auth-form">
            <label class="statement-field"><span>Логин</span><input class="statement-input" autocomplete="username" required maxlength="100" @bind="username" /></label>
            <label class="statement-field"><span>Пароль</span><input class="statement-input" type="password" autocomplete="current-password" required maxlength="128" @bind="password" /></label>
            @if (error is not null) { <p class="auth-error" role="alert">@error</p> }
            <button class="auth-button" type="submit" disabled="@busy"><i class="fas fa-right-to-bracket" aria-hidden="true"></i><span>@(busy ? "Вход..." : "Войти")</span></button>
        </form>
        @if (demoLoginEnabled)
        {
            <div class="demo-login-grid" aria-label="Тестовый вход">
                <button type="button" disabled="@busy" @onclick='() => LoginDemo("admin")'>Админ</button>
                <button type="button" disabled="@busy" @onclick='() => LoginDemo("teacher")'>Преподаватель</button>
                <button type="button" disabled="@busy" @onclick='() => LoginDemo("student")'>Студент</button>
            </div>
        }
    </div>
</section>

@code {
    private string username = "";
    private string password = "";
    private string? error;
    private bool busy;
    private bool demoLoginEnabled;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (await Auth.IsAuthenticatedAsync())
            Navigation.NavigateTo(Auth.CurrentUser!.MustChangePassword ? "/account/security" : "/", replace: true);
        else
        {
            try { demoLoginEnabled = await Auth.IsDemoLoginEnabledAsync(); }
            catch (HttpRequestException) { demoLoginEnabled = false; }
            StateHasChanged();
        }
    }
    private Task SubmitLogin() => SignIn(() => Auth.LoginAsync(username.Trim(), password));
    private Task LoginDemo(string user) => SignIn(() => Auth.DemoLoginAsync(user));
    private async Task SignIn(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            await action(); password = "";
            Navigation.NavigateTo(Auth.CurrentUser!.MustChangePassword ? "/account/security" : "/", replace: true);
        }
        catch (SessionExpiredException) { error = "Неверный логин или пароль. Вход может быть временно заблокирован после нескольких ошибок."; }
        catch (HttpRequestException) { error = "Сервер недоступен. Повторите позже."; }
        catch (Exception exception) { error = exception.Message; }
        finally { busy = false; }
    }
}
